{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipthread.dev/schemas/prompt-flow.schema.json",
  "title": "Clipthread prompt flow",
  "description": "Stored in campaigns.prompt_flow. Mirrors web/lib/prompt-flow.ts (zod), which is the runtime source of truth.",
  "type": "object",
  "required": ["version", "prompts"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "intro": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "maxLength": 120 },
        "body": { "type": "string", "maxLength": 1000 },
        "estimatedMinutes": { "type": "number", "minimum": 0 }
      }
    },
    "fields": {
      "description": "Text details collected before recording (shown on the wall unless public=false).",
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
          "label": { "type": "string", "maxLength": 80 },
          "type": { "enum": ["text", "email", "url"], "default": "text" },
          "required": { "type": "boolean", "default": false },
          "maxLength": { "type": "integer", "minimum": 1, "maximum": 500, "default": 200 },
          "public": { "type": "boolean", "default": true }
        }
      }
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "title", "maxSeconds"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
          "title": { "type": "string", "maxLength": 200 },
          "body": { "type": "string", "maxLength": 1000 },
          "prepSeconds": { "type": "integer", "minimum": 0, "maximum": 60, "default": 5 },
          "minSeconds": { "type": "integer", "minimum": 0, "maximum": 600, "default": 0 },
          "maxSeconds": { "type": "integer", "minimum": 5, "maximum": 600 },
          "optional": { "type": "boolean", "default": false }
        }
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxRetakes": { "type": "integer", "minimum": 0, "maximum": 10, "default": 3 },
        "maxSegmentBytes": { "type": "integer", "minimum": 1048576, "maximum": 5368709120, "default": 524288000 },
        "mimeTypes": { "type": "array", "items": { "type": "string" } },
        "video": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer", "default": 1280 },
            "height": { "type": "integer", "default": 720 },
            "frameRate": { "type": "integer", "default": 30 }
          }
        }
      }
    }
  }
}
