SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clipthread-media
R2_ENDPOINT=

# Must equal PROCESSOR_WEBHOOK_SECRET in web/.env.local
PROCESSOR_WEBHOOK_SECRET=

# openai | local
TRANSCRIBE_BACKEND=openai
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
# for TRANSCRIBE_BACKEND=local (faster-whisper): tiny|base|small|medium|large-v3|turbo
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default

WORKER_CONCURRENCY=2
KEEP_SOURCE_SEGMENTS=true
