# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (from `supabase status` or the dashboard) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clipthread-media
# Optional: override the endpoint (e.g. http://127.0.0.1:9000 for MinIO in dev)
R2_ENDPOINT=

# --- Secrets (generate each with: openssl rand -hex 32) ---
# Signs consent records. Rotating it invalidates verification of old records,
# so keep old values around (CONSENT_SIGNING_SECRET_PREVIOUS) if you rotate.
CONSENT_SIGNING_SECRET=
# Shared with the FastAPI processor to sign webhooks.
PROCESSOR_WEBHOOK_SECRET=

# --- FastAPI processor ---
# Leave empty to rely solely on R2 event notifications (cloudflare/r2-event-forwarder).
PROCESSOR_URL=http://127.0.0.1:8000
